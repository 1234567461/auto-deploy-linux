[Unit]
Description=Minecraft Server (PaperMC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/mc-server
ExecStart=/usr/bin/java -Xmx1G -Xms512M -jar /opt/mc-server/paper.jar nogui
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
